              <widget class="QWidget" name="cal_pump_tab">
               <attribute name="title">
                <string>Pump Spectrum (Shaper)</string>
               </attribute>
               <layout class="QVBoxLayout" name="cal_pump_layout">
                <item>
                 <layout class="QHBoxLayout" name="cal_pump_pop_layout">
                  <item>
                   <widget class="QPushButton" name="cal_pump_btn_pop_raw">
                    <property name="text"><string>🔍 Raw Intensities</string></property>
                    <property name="styleSheet"><string notr="true">font-size: 10px; font-weight: bold; padding: 2px 6px;</string></property>
                   </widget>
                  </item>
                  <item>
                   <widget class="QPushButton" name="cal_pump_btn_pop_abs">
                    <property name="text"><string>🔍 Absorbance</string></property>
                    <property name="styleSheet"><string notr="true">font-size: 10px; font-weight: bold; padding: 2px 6px;</string></property>
                   </widget>
                  </item>
                  <item>
                   <widget class="QPushButton" name="cal_pump_btn_pop_ref">
                    <property name="text"><string>🔍 Reference Fit</string></property>
                    <property name="styleSheet"><string notr="true">font-size: 10px; font-weight: bold; padding: 2px 6px;</string></property>
                   </widget>
                  </item>
