               </attribute>
               <layout class="QVBoxLayout" name="cal_det2_layout">
                <item>
                 <layout class="QHBoxLayout" name="cal_det2_pop_layout">
                  <item>
                   <widget class="QPushButton" name="cal_det2_btn_pop_raw">
                    <property name="text"><string>🔍 Raw Intensities</string></property>
                    <property name="styleSheet"><string notr="true">font-size: 10px; font-weight: bold; padding: 2px 6px;</string></property>
                   </widget>
                  </item>
                  <item>
                   <widget class="QPushButton" name="cal_det2_btn_pop_abs">
                    <property name="text"><string>🔍 Absorbance</string></property>
                    <property name="styleSheet"><string notr="true">font-size: 10px; font-weight: bold; padding: 2px 6px;</string></property>
                   </widget>
                  </item>
                  <item>
                   <widget class="QPushButton" name="cal_det2_btn_pop_ref">
