     <widget class="QTabWidget" name="MainTabs">
      <property name="styleSheet">
       <string notr="true">QTabWidget#MainTabs::pane { /* The tab widget frame */
    border-top: 1px solid #C2C7CB;
}

QTabWidget#MainTabs::tab-bar {
    left: 5px; /* move to the right by 5px */
}

/* Style the tab using the tab sub-control. Note that
    it reads QTabBar _not_ QTabWidget */
QTabWidget#MainTabs &gt; QTabBar::tab {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #E1E1E1, stop: 0.4 #EEEEEE,
                                stop: 0.5 #EFEFEF, stop: 1.0 #D3D3D3);
    border: 1px solid #C4C4C3;
    border-bottom-color: #C2C7CB; /* same as the pane color */
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    min-width: 30ex;
    padding:4px;
}

QTabWidget#MainTabs &gt; QTabBar::tab:selected, QTabWidget#MainTabs &gt; QTabBar::tab:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #fafafa, stop: 0.4 #f4f4f4,
                                stop: 0.5 #e7e7e7, stop: 1.0 #fafafa);
}

QTabWidget#MainTabs &gt; QTabBar::tab:selected {
    border-color: #9B9B9B;
    border-bottom-color: #C2C7CB; /* same as pane color */
}

QTabWidget#MainTabs &gt; QTabBar::tab:!selected {
    margin-top: 2px; /* make non-selected tabs look smaller */
}</string>
